# --- forge-managed state -----------------------------------------------
.mise/
.task/
.env
.env.overrides

# --- quality gate ------------------------------------------------------
# NOTE: .quality-baseline.json is COMMITTED on purpose. Loosening the gate
# must be visible in a diff.

# --- generic -----------------------------------------------------------
# Scoped to the repo root on purpose. A bare `*.log` also swallowed the worked
# example's telemetry, so its committed review cited lines that were not in the
# clone - breaking the one property this project exists to guarantee.
/*.log
.DS_Store
__pycache__/
*.py[cod]

# --- this project ------------------------------------------------------
# Raw agent trajectories are verbatim session transcripts and may contain
# credentials. Only trajectories/redacted/ is committed. See docs/TOOLS.md.
trajectories/raw/
trajectories/capture.log

# Saved copy of the challenge page: large, and not ours to redistribute.
specs/page.html

node_modules/
dist/
out/
examples/public-*/*.log

# Scratch space for reading the challenge brief. Not part of the deliverable.
specs/

# Fetched from loghub, never redistributed. See tools/demo/fetch-public-logs.sh.
examples/public-*/*.log
