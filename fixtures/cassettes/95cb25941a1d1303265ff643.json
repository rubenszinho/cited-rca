  "content": "{\n  \"root_cause\": \"schema_migration_regression\",\n  \"summary\": \"A database migration was applied that dropped and recreated an index on the orders table, which caused a surge in sequential scans and CPU usage. This led to slow queries and statement timeouts on the /orders/history API route, triggering alerts and degraded API performance.\",\n  \"onset_ts\": \"2026-03-17T09:26:00.000Z\",\n  \"timeline\": [\n    {\n      \"statement\": \"A migration was applied at 09:25 that dropped idx_orders_customer_created and created idx_orders_customer.\",\n      \"citations\": [\n        {\n          \"source\": \"changes.jsonl\",\n          \"line\": 2,\n          \"quote\": \"\\\"ts\\\":\\\"2026-03-17T09:25:00.000Z\\\",\\\"kind\\\":\\\"migration\\\",\\\"ref\\\":\\\"0142_orders_index\\\",\\\"actor\\\":\\\"ci-bot\\\",\\\"summary\\\":\\\"drop idx_orders_customer_created; create idx_orders_customer\\\"\"\n        }\n      ]\n    },\n    {\n      \"statement\": \"At 09:26, the database experienced a sudden spike in mean query time to over 3000 ms and a large increase in sequential scans to 560 per minute.\",\n      \"citations\": [\n        {\n          \"source\": \"metrics/db.csv\",\n          \"line\": 28,\n          \"quote\": \"2026-03-17T09:26:00.000Z,3421.3,560,31.9\"\n        }\n      ]\n    },\n    {\n      \"statement\": \"Slow query warnings for sequential scans on the orders table started appearing at 09:26:05 and continued frequently thereafter.\",\n      \"citations\": [\n        {\n          \"source\": \"logs/app.jsonl\",\n          \"line\": 685,\n          \"quote\": \"\\\"ts\\\":\\\"2026-03-17T09:26:05.000Z\\\",\\\"service\\\":\\\"db-proxy\\\",\\\"level\\\":\\\"warn\\\",\\\"msg\\\":\\\"slow query\\\",\\\"ms\\\":4200,\\\"table\\\":\\\"orders\\\",\\\"plan\\\":\\\"Seq Scan on orders\\\"\"\n        }\n      ]\n    },\n    {\n      \"statement\": \"Statement timeouts of 5000ms started occurring on the /orders/history route at 09:26:20 and persis