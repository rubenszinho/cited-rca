# PROJECT-OWNED. Edit this file for your project.
#
# Rendered to .env by `task env:render`. Do not edit .env by hand - it is
# regenerated and gitignored. Real secrets go in .env.overrides, which is
# never rendered and is loaded after .env.
#
# Two directives are substituted (double curly braces):
#   session      -> <repo>-<branch>, the isolation key
#   port "name"  -> a port unique to this session; same name = same port

# --- session ------------------------------------------------------------
# Every container, volume and process is named after SESSION so two
# worktrees of this repo never collide.
SESSION={{ session }}

# --- ports --------------------------------------------------------------
APP_PORT={{ port "app" }}
DB_PORT={{ port "database" }}
PC_PORT={{ port "process-compose" }}

# --- wiring -------------------------------------------------------------
# Cross-reference ports by name rather than repeating the number.
APP_URL=http://localhost:{{ port "app" }}
CORS_ORIGINS=http://localhost:{{ port "app" }}

# --- model provider -----------------------------------------------------
# Provider-agnostic on purpose: anything speaking the OpenAI chat-completions
# contract works, so a judge can point this at their own account without
# touching code. Defaults below are OpenRouter.
#
# LLM_API_KEY is a real secret and therefore does NOT belong here - this file
# is committed. Put it in .env.overrides, which is gitignored and takes
# precedence over everything rendered here. Anything below can be overridden the
# same way; `task project:env:show` prints what is actually in effect.
#
#     echo 'LLM_API_KEY=sk-or-v1-...' >> .env.overrides
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-sonnet-4.5

# Cost per case is a reported metric, so runs are capped rather than open-ended.
LLM_MAX_TOKENS=8000
LLM_TEMPERATURE=0

# USD per million tokens, used to report cost per incident. Not a secret, and
# not read by anything but the reporting - set these to your provider's rates
# to have the results table price your own run.
LLM_PRICE_IN_PER_MTOK=3
LLM_PRICE_OUT_PER_MTOK=15
